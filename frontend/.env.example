# Lin Garden frontend — copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored. The browser only ever uses the PUBLISHABLE (anon) key.

# Supabase (browser). RLS is scoped to slug 'lin-garden', so the publishable
# key can READ orders / order_items for the live order card.
VITE_SUPABASE_URL=https://ddefikvtbmnruvrzzgzv.supabase.co
# Project Settings -> API -> Publishable key (starts with sb_publishable_ or the
# legacy anon JWT). NEVER put the secret key here — it would ship to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Connection mode: "local" (default) talks to the local dev runner over
# SmallWebRTC; "cloud" talks to a deployed Pipecat Cloud agent over Daily.
VITE_PIPECAT_MODE=local

# --- local mode ---
# SmallWebRTC offer endpoint. A relative path goes through the Vite dev proxy to
# the agent on :7860 (see vite.config.ts). For a self-hosted deployed agent, set
# this to the absolute offer URL, e.g. https://your-agent.example.com/api/offer
VITE_PIPECAT_CONNECT_URL=/api/offer

# --- cloud mode (VITE_PIPECAT_MODE=cloud) ---
# The browser POSTs to https://api.pipecat.daily.co/v1/public/<name>/start to
# provision a Daily room. The PUBLIC API key ships in the browser bundle — only
# use a public key here, never a secret, and expect it to be readable by anyone.
VITE_PIPECAT_AGENT_NAME=
VITE_PIPECAT_API_KEY=
