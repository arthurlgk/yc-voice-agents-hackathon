# Lin Garden frontend — copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored. The browser only ever uses the PUBLISHABLE (anon) key.

# Supabase (browser). RLS is scoped to slug 'lin-garden', so the publishable
# key can READ orders / order_items for the live order card.
VITE_SUPABASE_URL=https://ddefikvtbmnruvrzzgzv.supabase.co
# Project Settings -> API -> Publishable key (starts with sb_publishable_ or the
# legacy anon JWT). NEVER put the secret key here — it would ship to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Pipecat SmallWebRTC offer endpoint. A relative path goes through the Vite dev
# proxy to the agent on :7860 (see vite.config.ts). For a deployed agent, set
# this to the absolute offer URL, e.g. https://your-agent.example.com/api/offer
VITE_PIPECAT_CONNECT_URL=/api/offer
