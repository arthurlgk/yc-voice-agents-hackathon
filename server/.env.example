# Lin Garden (Nemotron) — restaurant ordering agent environment template.
# Copy to .env and fill in the secrets:  cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# Local run mode. REQUIRED for local WebRTC dev: skips the Krisp noise filter,
# which is only available when deployed to Pipecat Cloud.
ENV=local

# Gradium (TTS). The "gradient" key handed out at the event (starts with gsk_).
GRADIUM_API_KEY=
# Voice ID. Either give a real ID (the sample default below works), or DELETE
# this line entirely. Do NOT leave it set to empty — an empty value is passed
# through as the voice and TTS fails with "Embeddings not found"; the code's
# fallback only kicks in when the variable is fully unset.
GRADIUM_VOICE_ID=Eu9iL_CYe8N-Gkx_

# NVIDIA Nemotron ASR (STT) — event-hosted WebSocket endpoint.
NVIDIA_ASR_URL=ws://44.241.251.184:8080

# NVIDIA Nemotron LLM — event-hosted vLLM OpenAI-compatible endpoint.
NEMOTRON_LLM_URL=http://nemotron-fleet-alb-1322439314.us-west-2.elb.amazonaws.com/v1
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super
# Reasoning toggle. Keep false for low-latency voice.
NEMOTRON_ENABLE_THINKING=false

# Supabase (staging project). The agent reads the menu from here and writes
# orders + a call record back. The SECRET key is required: anon is read-only
# under RLS, so INSERTs into calls/orders need the server-side secret key.
SUPABASE_URL=https://ddefikvtbmnruvrzzgzv.supabase.co
SUPABASE_SECRET_KEY=

# Restaurant to read the menu from and attach orders to (must exist in Supabase
# with a seeded menu). Staging has the lin-garden menu seeded.
RESTAURANT_SLUG=lin-garden

# Identifies this hackathon agent on the calls row (agent_id) and the
# yc_hackathon- call_id prefix, so its traffic is distinguishable.
AGENT_ID=yc_hackathon

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
